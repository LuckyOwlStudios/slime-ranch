{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/LuckyOwlStudios/Slime-Ranch"
  },
  "license": "${mod_license}",
  "icon": "assets/slimeranch/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.luckyowlstudios.slimeranch.fabric.SlimeRanchFabric"
    ],
    "client": [
      "net.luckyowlstudios.slimeranch.fabric.SlimeRanchFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "mixins": [
    "slimeranch.mixins.json"
  ]
}
